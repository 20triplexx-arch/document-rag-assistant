# Reference only: the app reads process/system environment variables.
# It does NOT load this file or .env automatically. Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# Optional explicit local default; otherwise DEEPSEEK_MODEL / accepted app default.
RAG_DEFAULT_MODEL=
RAG_PORT=8765
RAG_USER_DAILY_LIMIT=20
RAG_GLOBAL_DAILY_LIMIT=100
RAG_MAX_CONCURRENT=2
RAG_COOKIE_SECURE=false
